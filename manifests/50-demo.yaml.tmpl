apiVersion: apps/v1
kind: Deployment
metadata:
  name: log-generator
  namespace: elk-demo
spec:
  replicas: 1
  selector:
    matchLabels:
      app: log-generator
  template:
    metadata:
      labels:
        app: log-generator
    spec:
      automountServiceAccountToken: false
      nodeSelector:
        kubernetes.io/os: linux
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: generator
          image: ${DEMO_IMAGE}
          command: [sh, -c]
          args:
            - |
              i=0
              while true; do
                i=$((i+1))
                printf '{"message":"ELK_LAB_OK","sequence":%s,"level":"INFO"}\n' "$i"
                sleep 2
              done
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
            limits:
              cpu: 100m
              memory: 32Mi
