apiVersion: v1
kind: ServiceAccount
metadata:
  name: filebeat
  namespace: logging-agents
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: elk-lab-filebeat
rules:
  - apiGroups: [""]
    resources: [pods, namespaces, nodes]
    verbs: [get, list, watch]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: elk-lab-filebeat
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: elk-lab-filebeat
subjects:
  - kind: ServiceAccount
    name: filebeat
    namespace: logging-agents
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: filebeat-config
  namespace: logging-agents
data:
  filebeat.yml: |
    filebeat.inputs:
      - type: filestream
        id: elk-lab-container-logs
        prospector.scanner.symlinks: true
        paths:
          - /var/log/containers/*_elk-demo_*.log
        parsers:
          - container: ~
        processors:
          - add_kubernetes_metadata:
              host: ${NODE_NAME}
              scope: node
              add_resource_metadata:
                deployment: false
                cronjob: false
              matchers:
                - logs_path:
                    logs_path: /var/log/containers/
    output.logstash:
      hosts: ["ingest-ls-beats.logging.svc:5044"]
      loadbalance: true
      ssl.certificate_authorities: ["/etc/filebeat/tls/ca.crt"]
      ssl.certificate: /etc/filebeat/tls/tls.crt
      ssl.key: /etc/filebeat/tls/tls.key
      ssl.verification_mode: full
    logging.level: info
    logging.to_files: false
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: filebeat
  namespace: logging-agents
spec:
  selector:
    matchLabels:
      app: filebeat
  updateStrategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 1
  template:
    metadata:
      labels:
        app: filebeat
    spec:
      serviceAccountName: filebeat
      nodeSelector:
        kubernetes.io/os: linux
      terminationGracePeriodSeconds: 30
      containers:
        - name: filebeat
          image: docker.elastic.co/beats/filebeat:${STACK_VERSION}
          args: ["-e", "-c", "/etc/filebeat/filebeat.yml"]
          env:
            - name: NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
          securityContext:
            runAsUser: 0
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
            seccompProfile:
              type: RuntimeDefault
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: 500m
              memory: 512Mi
          volumeMounts:
            - name: config
              mountPath: /etc/filebeat/filebeat.yml
              subPath: filebeat.yml
              readOnly: true
            - name: logs
              mountPath: /var/log
              readOnly: true
            - name: data
              mountPath: /usr/share/filebeat/data
            - name: tls
              mountPath: /etc/filebeat/tls
              readOnly: true
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: config
          configMap:
            name: filebeat-config
            defaultMode: 0644
        - name: logs
          hostPath:
            path: /var/log
            type: Directory
        - name: data
          hostPath:
            path: /var/lib/elk-lab-filebeat
            type: DirectoryOrCreate
        - name: tls
          secret:
            secretName: filebeat-client-tls
            defaultMode: 0600
        - name: tmp
          emptyDir: {}
